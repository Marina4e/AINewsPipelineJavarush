APP_NAME="AI Telegram News Pipeline"
API_PREFIX="/api"

POSTGRES_DB="aibot"
POSTGRES_USER="aibot"
POSTGRES_PASSWORD="change_me_postgres_password"
DATABASE_URL="postgresql+psycopg://aibot:change_me_postgres_password@postgres:5432/aibot"
REDIS_URL="redis://redis:6379/0"
ADMIN_API_KEY="change_me_long_random_admin_key"
AUTO_PUBLISH_POSTS=false

# OpenAI. If empty, the project uses demo generation without real AI calls.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Telegram publishing, easiest option:
# 1. Create a bot in @BotFather.
# 2. Add the bot as admin to your channel.
# 3. Put channel username here, for example @my_news_channel.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_TARGET_CHANNEL=""

# Telegram parsing with Telethon. Needed if you add sources with type "tg".
# Get values from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=""
TELEGRAM_SESSION_NAME="./data/aibot_session"
TELEGRAM_READER_SESSION_NAME="./data/aibot_reader_session"

PARSER_INTERVAL_MINUTES=30
SITE_REQUEST_TIMEOUT=15
DEFAULT_NEWS_LIMIT=10

# Pydantic reads list values from .env as JSON.
ALLOWED_LANGUAGES='["uk","en"]'
